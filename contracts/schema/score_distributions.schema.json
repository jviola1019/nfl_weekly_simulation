{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "sportsbook",
        "exchange",
        "consensus",
        "margin",
        "total"
      ]
    },
    "bins": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "array",
          "items": {}
        }
      ]
    }
  },
  "required": [
    "game_id",
    "kind",
    "bins"
  ],
  "additionalProperties": false
}
